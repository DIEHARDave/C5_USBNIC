# Config fragment (merged onto malta_defconfig) that reproduces the struct layouts of the
# Flashforge Creator 5 Pro vendor kernel (Ingenic X2600, "5.10.186+").
# Flashforge does not publish its kernel source or config; every option here was inferred from
# the printer's /proc/kallsyms, its exported-symbol table, and by comparing disassembly of the
# printer's kernel against this build (see ../verify).

# --- CPU / platform: Malta is the stand-in for a MIPS32r5 little-endian SMP board
CONFIG_MIPS_MALTA=y
CONFIG_CPU_LITTLE_ENDIAN=y
# CONFIG_CPU_BIG_ENDIAN is not set
CONFIG_CPU_MIPS32_R5=y
CONFIG_32BIT=y
CONFIG_PAGE_SIZE_4KB=y
CONFIG_HZ_100=y
CONFIG_SMP=y
CONFIG_MIPS_CPS=y
# CONFIG_MIPS_MT_SMP is not set
CONFIG_NR_CPUS=2
CONFIG_PREEMPT=y
CONFIG_HIGHMEM=y
CONFIG_FLATMEM=y
# vermagic must read "5.10.186+ SMP preempt mod_unload MIPS32_R5 32BIT"
CONFIG_LOCALVERSION="+"

# --- Core kernel options that change struct layouts or module format
CONFIG_SLAB=y
# CONFIG_SLUB is not set
CONFIG_DEBUG_SPINLOCK=y
# CONFIG_DEBUG_MUTEXES is not set
# CONFIG_DEBUG_LOCK_ALLOC is not set
# CONFIG_PROVE_LOCKING is not set
# CONFIG_DEBUG_ATOMIC_SLEEP is not set
# CONFIG_DEBUG_PREEMPT is not set
CONFIG_STACKPROTECTOR=y
# struct _ddebug is 24 bytes on the printer: no jump labels
# CONFIG_JUMP_LABEL is not set
CONFIG_DYNAMIC_DEBUG=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODVERSIONS is not set
# CONFIG_MODULE_SIG is not set
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_TRACEPOINTS is not set
CONFIG_PM=y
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y
# CONFIG_MEMCG is not set
# CONFIG_SECURITY is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_KASAN is not set
# CONFIG_UBSAN is not set
# CONFIG_GCOV_KERNEL is not set
CONFIG_CRC32=y
CONFIG_CRYPTO=y

# --- Networking (sk_buff / net_device layout)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
# CONFIG_NET_NS is not set
# CONFIG_IPV6 is not set
# CONFIG_XFRM_USER is not set
# CONFIG_NET_KEY is not set
# CONFIG_INET_AH is not set
# CONFIG_INET_ESP is not set
# CONFIG_INET_IPCOMP is not set
# CONFIG_XFRM is not set
# CONFIG_SKB_EXTENSIONS is not set
# CONFIG_NETWORK_SECMARK is not set
CONFIG_NETFILTER=y
# CONFIG_NF_CONNTRACK is not set
CONFIG_NET_INGRESS=y
CONFIG_NETFILTER_INGRESS=y
# CONFIG_NET_SCHED is not set
# CONFIG_ATALK is not set
CONFIG_BRIDGE=y
# CONFIG_BRIDGE_NETFILTER is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_NET_SWITCHDEV is not set
# CONFIG_DCB is not set
# CONFIG_MPLS is not set
# CONFIG_NET_L3_MASTER_DEV is not set
# CONFIG_MACSEC is not set
# CONFIG_NETPOLL is not set
# CONFIG_NET_POLL_CONTROLLER is not set
CONFIG_RPS=y
CONFIG_RFS_ACCEL=y
CONFIG_XPS=y
CONFIG_NET_RX_BUSY_POLL=y
CONFIG_NET_FLOW_LIMIT=y
CONFIG_ETHTOOL_NETLINK=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_RFKILL=y
# CONFIG_WIRELESS_EXT is not set
# CONFIG_WEXT_PRIV is not set
CONFIG_PHYLIB=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_PINCTRL=y
CONFIG_OF=y

# --- Malta defconfig drivers that would force MII built-in or re-enable WEXT
# CONFIG_PCNET32 is not set
# CONFIG_LIBERTAS is not set
# CONFIG_IPW2100 is not set
# CONFIG_PRISM54 is not set
# CONFIG_HOSTAP is not set
# CONFIG_ATMEL is not set

# --- The modules we want
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_NET_DRIVERS=m
CONFIG_USB_RTL8152=m
CONFIG_MII=m
# Built only to compare against Z-Mod's own cp210x.ko/usbserial.ko (verify/verify.sh)
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_CP210X=m
